# ESP32-C6 role: Wi-Fi coprocessor for the Guition ESP32-P4 host.
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_COMPILER_HIDE_PATHS_MACROS=y
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y

# The C6 SDIO peripheral uses fixed pins. These are the C6-side pins, not the
# P4 host-side GPIO 14..19 mapping.
CONFIG_EH_TRANSPORT_CP_SDIO=y
CONFIG_EH_TRANSPORT_CP_SDIO_MODE_SW_AGGR=y
CONFIG_EH_TRANSPORT_CP_SDIO_PIN_CMD=18
CONFIG_EH_TRANSPORT_CP_SDIO_PIN_CLK=19
CONFIG_EH_TRANSPORT_CP_SDIO_PIN_D0=20
CONFIG_EH_TRANSPORT_CP_SDIO_PIN_D1=21
CONFIG_EH_TRANSPORT_CP_SDIO_PIN_D2=22
CONFIG_EH_TRANSPORT_CP_SDIO_PIN_D3=23
CONFIG_EH_TRANSPORT_CP_SDIO_GPIO_RESET=-1
CONFIG_EH_TRANSPORT_CP_SDIO_HIGH_SPEED=y
CONFIG_EH_TRANSPORT_CP_SDIO_PSEND_PSAMPLE=y

CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_FREERTOS_HZ=1000

# Provisional 4 MB C6 flash profile. Verify the fitted C6 flash before moving
# the Guition target out of experimental status.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
