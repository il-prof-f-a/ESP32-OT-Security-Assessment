# ESP32 T-POE Pro Configuration
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_COMPILER_HIDE_PATHS_MACROS=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Persist the native ESP-IDF panic coredump in the dedicated flash partition.
# app_main inspects it on the next boot after NVS/AsyncStorage initialization.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
# IMPORTANT: Must match TaskConfig::SystemTasks::MAIN_STACK_SIZE in src/core/task_config.h
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144

# LittleFS support
CONFIG_LITTLEFS_MAX_PARTITIONS=3
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_OBJ_NAME_LEN=64
CONFIG_LITTLEFS_READ_SIZE=128
CONFIG_LITTLEFS_WRITE_SIZE=128
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_LITTLEFS_CACHE_SIZE=512
CONFIG_LITTLEFS_BLOCK_CYCLES=512

## Network optimizations for discovery scanning
## Increased sockets and memory for network discovery
# RIDOTTO: 64 socket causano errore LWIP_SOCKET_OFFSET < 6
# Limite sicuro con FD_SETSIZE=64: max 61 socket, usiamo 48 per sicurezza
CONFIG_LWIP_MAX_SOCKETS=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
# Increase semaphore and thread memory for parallel connections
CONFIG_LWIP_SO_RCVBUF=1
CONFIG_LWIP_THREAD_LOCAL_STORAGE_INDEX=1
CONFIG_LWIP_MAX_ACTIVE_TCP=32
CONFIG_LWIP_MAX_LISTENING_TCP=16
# OTTIMIZZATO AGGRESSIVO: TCP buffers ultra-ridotti per massimizzare DRAM
CONFIG_LWIP_TCP_SND_BUF=8192
CONFIG_LWIP_TCP_WND=8192
CONFIG_LWIP_TCP_MSS=1200
# OTTIMIZZATO: LWIP task stack ridotto
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=2048
# Smaller PBUF pool - ridotto ulteriormente
CONFIG_LWIP_PBUF_POOL_BUFSIZE=1500
CONFIG_LWIP_PBUF_POOL_SIZE=6

# Security - [* HTTPS TO ACTIVATE] quando RAM sarà stabile
# [* HTTPS TO ACTIVATE] CONFIG_MBEDTLS_TLS_ENABLED=y
# [* HTTPS TO ACTIVATE] CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=8192

# WiFi - Buffer OTTIMIZZATI AGGRESSIVI per massimizzare DRAM libera
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_STATIC_TX_BUFFER=n
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP32_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_CACHE_TX_BUFFER_NUM=12
CONFIG_ESP32_WIFI_TASK_STACK_SIZE=12228
CONFIG_ESP32_WIFI_EVENT_TASK_STACK_SIZE=12228
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# WiFi task must remain in internal RAM

# LWIP optimization - DISABLED: aumenta consumo DRAM!
# CONFIG_LWIP_IRAM_OPTIMIZATION=n

# Ethernet - OTTIMIZZATO AGGRESSIVO per ridurre DMA buffers
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y
CONFIG_ETH_RMII_CLK_OUTPUT=y
CONFIG_ETH_RMII_CLK_OUT_GPIO=0
CONFIG_ETH_ENABLE_PROMISCUOUS=y
# OTTIMIZZATO AGGRESSIVO: DMA buffers ridotti (10+10 → 4+4 = -8KB)
CONFIG_ETH_DMA_RX_BUFFER_NUM=8
CONFIG_ETH_DMA_TX_BUFFER_NUM=8

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y

# PSRAM configuration
## 8MB total, 4MB mapped heap
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
# Integrate PSRAM into default malloc
CONFIG_SPIRAM_USE_MALLOC=y
# Disable caps alloc as primary policy
#CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# DRAM reserves for stability - OTTIMIZZATO AGGRESSIVO per massimizzare DRAM heap
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=8192
# Consenti stack dei task in PSRAM anche per creazione statica/dinamica
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# HTTP server / web
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256
CONFIG_HTTPD_QUEUE_LEN=10

# IRAM optimization - DISABLED: riduce DRAM disponibile!
# CONFIG_ESP32_IRAM_AS_8BIT_ACCESSIBLE_MEMORY=y

# FreeRTOS memory optimizations
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2048
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072
CONFIG_FREERTOS_ISR_STACKSIZE=3072
CONFIG_ESP_IPC_TASK_STACK_SIZE=3072
CONFIG_ESP_IPC_USES_CALLERS_PRIORITY=y
CONFIG_ESP_IPC_ISR_ENABLE=y
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3072
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW=2
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# Heap debugging
#CONFIG_HEAP_POISONING_COMPREHENSIVE=y
#CONFIG_HEAP_TRACING_STACK_DEPTH=4
#CONFIG_HEAP_POISONING_LIGHT=y
#CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
#CONFIG_COMPILER_STACK_CHECK_MODE_ALL=y
#CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
#CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# ==================== WiFi CRASH PREVENTION ====================
# Disable WiFi/BT coexistence to prevent timer allocation failures
CONFIG_SW_COEXIST_ENABLE=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n

# Disable AMPDU aggregation to prevent allocation issues
CONFIG_ESP32_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP32_WIFI_AMPDU_RX_ENABLED=n

# Increase timer pool and memory for timer allocations
CONFIG_ESP_TIMER_MAX_TIMERS=32
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y

# Increase internal heap reserve for WiFi timer allocations
# NOTA: Questa riga è commentata perché già definita sopra (linea 83)
# CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304  # Vecchio valore 96KB
# Nuovo valore ottimizzato: 65536 (64KB) - vedi linea 83

CONFIG_LWIP_IPV6=n
